        "jsCode": "function escapeHTML(text) {\n  if (!text) return '';\n  return String(text)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;');\n}\n\nfor (const item of $input.all()) {\n  item.json.first_name_safe = escapeHTML(item.json.first_name);\n  item.json.last_name_safe = escapeHTML(item.json.last_name);\n  item.json.website_url_safe = escapeHTML(item.json.website_url);\n  item.json.service_type_safe = escapeHTML(item.json.service_type);\n  item.json.urgency_safe = escapeHTML(item.json.urgency);\n  item.json.email_safe = escapeHTML(item.json.email);\n}\n\nreturn $input.all();"
