    {
      "parameters": {
        "jsCode": "function escapeHTML(text) {\n  if (!text) return '';\n  return String(text)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;');\n}\n\nconst now = new Date();\nconst overdueLeads = [];\n\nfor (const item of $input.all()) {\n  const createdAtStr = item.json['تاریخ ثبت'];\n  if (!createdAtStr) continue;\n  \n  const createdAt = new Date(createdAtStr.replace(' ', 'T'));\n  const diffHours = (now - createdAt) / (1000 * 60 * 60);\n  \n  if (diffHours >= 24) {\n    item.json.first_name_safe = escapeHTML(item.json['نام']);\n    item.json.last_name_safe = escapeHTML(item.json['نام خانوادگی']);\n    item.json.website_url_safe = escapeHTML(item.json['ادرس سایت']);\n    item.json.service_type_safe = escapeHTML(item.json['نوع سرویس']);\n    item.json.urgency_safe = escapeHTML(item.json['سطح اضطراری']);\n    item.json.email_safe = escapeHTML(item.json['ایمیل']);\n    item.json.created_at_safe = escapeHTML(item.json['تاریخ ثبت']);\n    overdueLeads.push(item);\n  }\n}\n\nreturn overdueLeads;"
      },
